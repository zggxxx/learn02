<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learn.dao.RoleDAO">
    <sql id="noDelete">
        del_flag = 0
    </sql>
    <select id="queryRoles" resultType="RoleEntity" >
        select * from sys_role where <include refid="noDelete"/> ;
    </select>
    <select id="queryRoleByRoleId" resultType="RoleEntity" >
        select * from sys_role where role_id = #{roleId}
        and <include refid="noDelete"/>
    </select>
    <select id="findRoleCodesByUserId" resultType="String">
        select distinct r.role_code
        from sys_role r
        join sys_user_role ur on ur.role_id = r.role_id
        where ur.user_id = #{userId}
        and r.status = 1
        and r.del_flag = 0
    </select>
    <insert id="addRole" useGeneratedKeys="true" keyProperty="roleId" keyColumn="role_id">
        insert into sys_role (role_name,
        role_code,
        remark,
        create_by,
        update_by)values(#{roleName},#{roleCode},#{remark},#{createBy},#{updateBy})
    </insert>
    <delete id="deleteRolesByUserId" parameterType="Long">
        delete from sys_user_role where user_id = #{userId}
    </delete>
    <insert id="batchUserRole" parameterType="UserRoleEntity">
        insert into sys_user_role(user_id,role_id) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.userId},#{item.roleId})
        </foreach>
    </insert>
</mapper>