<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learn.dao.UserDAO">
    <sql id="activeStatus">
        status=1
    </sql>
    <sql id="noDelete">
        del_flag = 0
    </sql>
    <select id="queryUserById" resultType="UserEntity">
        select * from sys_user where user_id = #{userId}
        and <include refid="activeStatus"/>
        and <include refid="noDelete"/>
    </select>
    <select id="queryUsers" resultType="UserEntity">
        select * from sys_user where <include refid="activeStatus"/> and <include refid="noDelete"/>
    </select>
    <insert id="addUser" parameterType="UserEntity" useGeneratedKeys="true" keyProperty="userId" keyColumn="user_id">
        insert into sys_user (user_name,
        password,
        email,
        nickname,
        mobile,
        create_by,
        update_by)
        values(#{userName},#{password},#{email},#{nickname},#{mobile},#{createBy},#{updateBy});
    </insert>
    <update id="updateUser" parameterType="UserEntity" >
        update sys_user
        <set>
            <if test="userName != null and userName !=''">user_name = #{userName},</if>
            <if test="nickname!=null and nickname!=''">nickname = #{nickname},</if>
            <if test="password!=null and password!=''">password = #{password},</if>
            <if test="email!=null and email!=''">email = #{email},</if>
            <if test="mobile!=null and mobile!=''">mobile = #{mobile},</if>
            <if test="updateBy!=null">update_by = #{updateBy},</if>
            <if test="status!=null">status = #{status},</if>
        </set>

        where user_id = #{userId}
    </update>
</mapper>